{
  "name": "lumen-workspace",
  "version": "0.1.8",
  "description": "A readable terminal workspace for your code and AI agents",
  "author": "Lumen",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "package": "npm run build && electron-builder --win portable --config.win.signExecutable=false"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "8.3.1",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "build": {
    "appId": "app.lumen.workspace",
    "productName": "Lumen",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": "portable",
      "artifactName": "Lumen-${version}.exe",
      "icon": "public/lumen.ico"
    }
  }
}
